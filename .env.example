# Server
# Discord OAuth (create an application at https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Use the client origin callback while developing through the Vite proxy:
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback
CLIENT_ORIGIN=http://localhost:5173

# Local testing only. Never enable this on a public server.
RIFT_DEV_AUTH=1
# Local JSON account/save file; point this at a persistent volume in production.
RIFT_ACCOUNTS_FILE=data/accounts.json

# Client (optional; the default is ws://<current-host>:8787)
VITE_SERVER_URL=ws://localhost:8787
